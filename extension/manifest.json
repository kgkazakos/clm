{
  "manifest_version": 3,
  "name": "CLM Session Logger",
  "version": "4.0",
  "description": "Captures interaction telemetry for Cognitive Load Monitor validation",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CLM Logger"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
